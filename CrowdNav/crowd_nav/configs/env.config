# ============================================================
# env.config - 环境配置
# ============================================================

[env]
time_limit = 50
time_step = 0.25
val_size = 100
test_size = 500
randomize_attributes = false

[reward]
success_reward = 1.0
collision_penalty = -0.5
timeout_penalty = -0.5
progress_reward = 0.0
time_penalty = 0.0
stand_penalty = 0.0
discomfort_dist = 0.2
discomfort_penalty_factor = 0.5

[sim]
train_val_sim = circle_crossing
test_sim = circle_crossing
square_width = 10
circle_radius = 4
human_num = 5

[humans]
visible = true
policy = orca
radius = 0.3
v_pref = 1.0
sensor = coordinates

[robot]
visible = false
policy = none
radius = 0.3
v_pref = 1.0
sensor = coordinates
success_radius = 0.25

[orca]
neighbor_dist = 10.0
max_neighbors = 10
time_horizon = 5.0
time_horizon_obst = 5.0
# ========== SARL "降维打击"机制 ==========
# RL阶段：小safety_space → 比IL阶段宽松，机器人有安全冗余
# safety_space = 0.2  # 原值
safety_space = 0.10  # ABLATION: RL阶段比IL(0.25)更宽松

[action_space]
kinematics = holonomic

[policy]
n_speeds = 5
n_headings = 16
v_min = 0.05
v_max = 1.0
sampling = exponential
include_stop = false
stop_eps = 0.05

# Order 17: geometric occlusion and the dynamic Bayesian occupancy belief.
# One section serves all four experimental arms; `mode` is the only thing that
# differs between them, so an arm cannot silently drift on some other setting.
# enabled = false reproduces the pre-occlusion behaviour bit for bit.
[occlusion]
enabled = false
mode = off
grid_resolution = 0.25
grid_extent = 5.0
fov_radius = 5.0
max_entities = 10
token_contract = belief_v3
visible_slots = 5
hidden_slots = 10
p_prior = 0.05
p_hit = 0.85
p_miss = 0.01
decay = 0.90
diffuse = 0.35
p_report = 0.30
schema_version = 3
