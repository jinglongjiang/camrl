# Policy config for SM-BRNE (crowd_nav/bayesian_brne/policy.py).
#
# [bayesian_model] and [planner] sections map 1:1 onto
# crowd_nav.bayesian_brne.config.BayesianModelConfig / PlannerConfig --
# every tunable number the algorithm uses must be traceable to one of these
# two sections (guide.md 4.3); no magic numbers in algorithm files.

[policy]
key = bayesian_brne

[bayesian_model]
k_candidates = 1,2,3,4,5,6
n_particles = 128
min_mode_fraction = 0.03
max_mode_similarity = 0.98
covariance_floor = 1e-4
dt = 0.25
# Placeholders -- must be re-derived from train-split speed/acceleration
# quantiles and frozen before validation once real 5-person data exists
# (Step 5); see guide.md 6.3/B3.
max_human_speed = 2.0
max_human_acceleration = 2.0

[planner]
# M=64, H=12 are the first formal candidates, not fixed truths -- may be
# tuned exactly once against validation + the latency benchmark (Step 8),
# then frozen (guide.md 4.3).
horizon_steps = 12
num_samples = 64
max_speed = 2.0
max_acceleration = 2.0
max_outer_iterations = 10
outer_tolerance = 1e-3
# R4 fixed-point diagnostics. Damping=1.0 preserves the undamped reference;
# it is recorded explicitly so an accidental hidden relaxation is impossible.
outer_damping = 1.0
oscillation_tolerance = 1e-6
equilibrium_iterations = 10
solver_mode = stable_clearance
safe_distance = 0.20
cost_sigma = 0.10
cost_scale = 100.0
# Sparse graph pruning is not implemented until R6; true would be a silent no-op.
sparse_enabled = false
pruning_margin = 0.0
max_missed_steps = 5
belief_seed = 2407
sampling_mode = full_posterior
seed = 2407

[eval_envs]
baseline_circle = circle:4.0:5
baseline_square = square:10.0:10
dense_circle = circle:4.0:10
dense_square = square:10.0:20
large_circle = circle:6.0:12
large_square = square:14.0:20

[eval_protocol]
episodes_per_env = 100
human_policies = orca
robot_visible = true
time_limit = 35
time_step = 0.25
success_radius = 0.25
discomfort_threshold = 0.2

[brne_upstream]
root = /home/abc/temp/brne
commit = 633a5cdcb39ab27f18b596cb8cb1968644f82391

[artifact]
# This is an engineering-only artifact for pipeline checks, not a scientific
# result. S1 may replace it only after the strict artifact gate passes.
path = /home/abc/workspace/nav_data/mamba/camrl/CrowdNav/runs/bayesian_brne/framework_build_20260803T125830Z/engineering_only_artifact_r3
tier = engineering_only
