# Dedicated environment config for belief_mdp.
#
# Same [reward]/[sim]/[humans]/[robot]/[orca] sections as env_gdbn.config
# (full-crowd defaults; [sim] human_num/test_sim/square_width/circle_radius
# are overridden at runtime per scenario by runtime.build_full_crowd_environment
# regardless of what is written here).
#
# [policy] is NOT copied from env_gdbn.config: that file defines 5x16+stop=81
# actions, which does not match the frozen Mamba-VL checkpoint
# (runs/mamba_vl/rl_model_ep10000_T24.pth), trained with the 80-action grid
# below (5 speeds x 16 headings, exponential sampling, no stop -- copied
# verbatim from configs/env.config, the config that checkpoint was actually
# trained under). Loading the wrong grid silently changes the action count
# and breaks the checkpoint's q_head shape (80 vs 81) -- this file exists so
# that mistake cannot recur.
#
# time_limit = 35 (not env_gdbn.config's 25): this matches the formal
# six-scenario full-crowd protocol's --time-limit 35 used to produce this
# project's actual paper-level results. An earlier version of this file used
# 25s, which silently capped every episode at 100 internal steps regardless
# of evaluate.py's own --max_steps=200 argument (the internal env cutoff
# fires first), so the formal belief_mdp protocol was not actually
# comparable to the paper's protocol until this was fixed.

[env]
time_limit = 35
time_step = 0.25
val_size = 100
test_size = 500
randomize_attributes = false

[reward]
success_reward = 1.0
collision_penalty = -0.5
timeout_penalty = -0.5
progress_reward = 0.01
time_penalty = -0.003
stand_penalty = 0.0
discomfort_dist = 0.2
discomfort_penalty_factor = 0.5

[sim]
train_val_sim = circle_crossing
test_sim = circle_crossing
square_width = 10
circle_radius = 4
human_num = 5

[humans]
visible = true
policy = orca
radius = 0.3
v_pref = 1.0
sensor = coordinates

[robot]
visible = false
policy = none
radius = 0.3
v_pref = 1.0
sensor = coordinates
success_radius = 0.25

[orca]
neighbor_dist = 10.0
max_neighbors = 10
time_horizon = 5.0
time_horizon_obst = 5.0
safety_space = 0.10

[action_space]
kinematics = holonomic

[policy]
n_speeds = 5
n_headings = 16
v_min = 0.05
v_max = 1.0
sampling = exponential
include_stop = false
stop_eps = 0.05
