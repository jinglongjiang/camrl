# ============================================================
# train_intent_bdvl.config
#
# THE SINGLE SOURCE OF TRUTH for goal-intent BDVL (V6) formal training.
#
# Unlike the older train_bayesian_dvl.config -- which is documentation
# only, duplicating FROZEN_VALUES for human reference -- this file IS READ
# AT RUNTIME by crowd_nav.bayesian_dvl.intent_config.load_intent_training_config().
# The CLI has NO formal hyperparameter defaults of its own: every value
# below must come from here, so there is exactly one place a formal run's
# hyperparameters can be defined (plan section 5 / Order C2.1).
#
# FROZEN before training starts. These are PRE-REGISTERED ENGINEERING
# CHOICES, not proven optima. They must not be retuned against validation
# or test success rate. A change here is a new, separately-versioned
# training contract, not an edit to this one.
# ============================================================

[schema]
# All four must match the running code or the config fails closed.
feature_schema = bdvl_z_state_goal_intent_v6_candidate_set
training_contract_schema = bdvl_intent_training_contract_capped_rank_audit_only_v5
checkpoint_schema = bdvl_intent_checkpoint_v7_candidate_set
scenario_registry_id = bdvl_junction_scenario_v2_corridor_split

[il]
# Inherited from train_bayesian_dvl.config's existing 5000 IL budget,
# split evenly across the two training scenarios.
il_episodes_total = 5000
il_episodes_standard = 2500
il_episodes_junction_crowd = 2500
# FROZEN at 2400 by the 3-seed fixed-budget calibration (rho=1.0, seeds
# 98211/98212/98213, IL 3000 each). All three satisfied the pre-registered
# constraints at pass 2400:
#     98211  MC=0.114163  rank=0.068175  margin=+0.03189
#     98212  MC=0.128972  rank=0.028552  margin=+0.09185
#     98213  MC=0.116144  rank=0.074265  margin=+0.04179
# This is a FIXED budget, not a selection point: IL always runs exactly
# 2400 passes and hands the pass-2400 weights straight to online RL. No
# audit-based checkpoint selection, no early stopping, no re-tuning.
il_passes = 2400

[online]
# Existing hard cap; the two training scenarios are strictly 1:1
# (plan section 4.1: the mix is frozen here, never adjusted on results).
online_episodes_total = 10000
mix_standard = 0.5
mix_junction_crowd = 0.5
updates_per_episode = 1

[optim]
batch_size = 256
# C4R.2: every ONLINE update mixes this share of DEMO samples so the
# expert ranking supervision does not vanish when IL ends (the previous
# online-only buffer made rank_loss permanently 0 during the RL phase).
demo_sample_ratio = 0.20
# Bounded DEMO reservoir. The formal IL budget is ~195k transitions
# (measured ~39/episode x 5000); the reservoir keeps a uniform sample
# within a fixed memory budget rather than holding everything.
demo_capacity = 200000
replay_capacity = 200000
learning_rate = 1e-4
gamma = 0.99
grad_clip_norm = 10.0

[exploration]
# Linear decay spanning ALL online episodes (not a step schedule).
epsilon_start = 0.30
epsilon_end = 0.05
epsilon_decay_episodes = 10000

[ranking]
# ranking_margin: kept at the existing 0.10; not tuned on test SR.
#
# lambda_rank is RETIRED. It was a scalar weight on the ranking term,
# measured at 380 to equalize gradient magnitudes at initialization. The
# training chain no longer uses a scalar weight at all: combine_gradients
# projects the ranking gradient off any component that opposes the MC
# gradient and rescales by rank_share (see [gradient_balance]). Leaving
# 380.0 in the config declared and hashed a number that took no part in
# training -- the same provenance lie as the tracker knobs that were
# hashed but never passed.
ranking_margin = 0.10
# C4R.1: hard cap on how many DEMO rows in a batch get the expensive
# 80-action ranking pass. Must be a real number here -- the CLI is no
# longer allowed to pass None and silently rank the entire batch.
ranking_batch_size = 32
# C4R.3: how often to pay for the two extra autograd passes that measure
# the per-term gradient ratio. Every update would roughly triple the
# backward cost; the gate is about sustained drift, not single batches.
gradient_diagnostic_interval = 50

[gradient_balance]
# No lambda, and no fixed share either. Any component of g_rank opposing
# g_MC is projected out, then the remainder is CAPPED at rank_cap_rho of
# |g_MC| -- an upper bound only. A ranking gradient already inside its
# budget passes through untouched.
#
# rank_share = 2.0 is RETIRED. It normalised the projected ranking gradient
# to EXACTLY 2x |g_MC| whenever it was not numerically zero, which is a
# floor as well as a ceiling: a nearly-satisfied hinge was scaled back UP,
# so ranking never yielded as it converged. Measured on 3 diagnostic seeds,
# IL 2000 each (the 12-branch 2x2):
#     share=2.0, Adam kept    final/best MC = 1.500 / 1.285 / 1.162
#     share=2.0, Adam reset   final/best MC = 1.526 / 1.282 / 1.217
#     MC-only                 final/best MC = 1.056 / 1.059 / 1.036
# The fixed TRAINING set degraded too (0.139-0.175 vs MC-only 0.102-0.109),
# and the best MC ever reached was 0.117-0.123 vs MC-only's 0.086-0.089 --
# so this was not late over-fitting; it cost ~30% of the achievable value
# fit from the start. Resetting Adam at the phase transition did NOT help
# (worse on 2 of 3 seeds), so that hypothesis is retired too.
#
# MC-only is not the answer: it left rank loss 0.10-0.13, margin NEGATIVE
# and top-1 at 22-31%. The supervision has to stay; it must simply not be
# able to outbid value regression.
#
# FROZEN at 1.0. Calibration is CLOSED: 0.5 and 1.0 were each run on 3
# seeds. At the retired 2000-pass budget both rho failed (1 of 3 seeds),
# but rank was still falling monotonically at pass 2000 -- the budget, not
# rho, was the binding constraint. Re-run at 3000 passes, rho=1.0 gave a
# feasible point on 3 of 3 seeds, and pass 2400 is the first pass where all
# three are simultaneously feasible (see [il] il_passes). rho is not
# re-calibrated again.
rank_cap_rho = 1.0
# |g'_rank| at or below this fraction of max(|g_MC|, 1) is treated as zero,
# so a satisfied hinge degenerates to a pure-MC update instead of having
# floating-point noise normalised up to a full share.
rank_zero_tolerance = 1e-8

[audit_split]
# Order 2W: the audit set is held out BY EPISODE from the raw ORCA corpus
# and never enters replay, warm-up or any gradient update.
#
# Real leak this replaces: the audit rows used to be the SAME rows already
# added to the replay, so "audit" measured training performance. Warm-up
# reached top1 0.951 in 500 steps that way; on genuinely disjoint episodes
# the same procedure reached 0.879-0.945 in 750.
#
# Split by EPISODE, not by row: rows within an episode are temporally
# adjacent and would leak almost as badly.
# Pilot: 500 train + 100 audit. Formal: 4900 train + 100 audit.
audit_episodes_per_scenario = 50

[ranking_warmup]
# Order 1W: train the ranking objective ALONE until the fixed audit set says
# it was learned. Measured: ranking alone reaches top1 0.96+ and margin
# +0.127 within this budget, while under joint training with an ill-scaled
# weight it never left the margin (score range 0.0017, top1 52.7%).
# Not reaching the bar is a HARD STOP -- entering joint training with an
# unlearned ranking term is what produced the aborted pilot.
warmup_max_steps = 750
warmup_check_interval = 50
# RETIRED as a gate (top1 >= 0.95): that threshold was calibrated on an
# audit set drawn from the TRAINING pool -- leaked rows. Warm-up reached
# 0.951 in 500 steps that way; on a genuinely held-out split the same
# procedure plateaus at 0.933 (three runs: 0.9328/0.933/0.937, and 500->750
# steps moved it only 0.929->0.933) while rank_loss reached 0.0166 and
# margin +0.117. The gate is now the two quantities the ranking objective is
# DEFINED by; top-1 is recorded as telemetry.
warmup_rank_loss_max = 0.05

[audit]
# How often the FIXED held-out audit set is evaluated and logged, in IL
# passes. It sets a recording frequency and nothing else: the audit does
# not judge a run. Whether a run is worth keeping is decided afterwards
# by the checkpoint selector, which can see the whole curve.
audit_interval = 100

[iqn]
# train draws tau from the explicit resumable generator; deployment/eval
# uses FIXED midpoint quantiles (deterministic scoring).
iqn_train_quantiles = 16
iqn_eval_quantiles = 32

[belief]
# Tracker + posterior-future summary. Written into the registry so an
# evaluator can never silently use a different horizon than training did.
future_horizon = 8
future_n_samples = 60
tracker_sigma = 0.5
tracker_persistence = 0.98
tracker_waypoint_radius = 0.35
missing_timeout_steps = 8
max_candidate_goals = 8
# Speed model (GLOBAL, all scenarios). speed_prior is used only for a track's
# first frame; after that the tracker runs a clipped EMA of observed speed.
# Validated against intent_runtime_config.TRACKER_DEFAULTS -- a value here
# that the code does not use is a hard error, not a silent no-op.
tracker_speed_prior = 1.0
tracker_estimate_speed = true
tracker_speed_ema_alpha = 0.3
tracker_speed_min = 0.2
tracker_speed_max = 2.5

[ema]
# The deployment/paper weights are the FINAL EMA, exported as its own
# artifact (final_ema.pth). No "pick the best-looking checkpoint".
ema_decay = 0.99

[checkpoint]
# Periodic ATOMIC checkpointing: a long run must survive a crash.
checkpoint_interval_episodes = 500

[monitoring]
# Mamba-VL-style online observability. Every episode is durably appended
# to metrics.jsonl/train.log; these windows drive rolling SR/CR/TR.
rolling_windows = 25, 50, 200
plot_interval_episodes = 50
# Development-only seeds below, never paper/formal seeds. Both standard
# and junction_crowd are evaluated greedily at each interval.
development_eval_interval_episodes = 500
tensorboard_enabled = true

[seeds]
# V2 seed roles. Mutually exclusive, hard-validated at load, and every V1
# block is retired -- the junction birth distribution changed and the feature
# schema changed, so no V1 episode can be reused or compared against.
#   junction mechanism audit   2_000_000-2_000_199 / 2_010_000-2_010_099
#   junction IL / online       2_100_000-2_102_499 / 2_200_000-2_204_999
#   junction validation        2_300_000-2_300_009
#   junction selection-dev     2_400_000-2_400_099
#   junction paper-test        2_500_000-2_500_499   (training MUST refuse)
#   standard IL / online       2_600_000-2_602_499 / 2_700_000-2_704_999
#   standard validation        2_800_000-2_800_009
#   standard selection-dev     2_900_000-2_900_099   (training MUST refuse)
# The values below are the per-run OPTIMIZER seeds for the multi-seed runs.
training_seeds = 98201, 98202, 98203, 98204, 98205
validation_seeds = 2800000, 2800001, 2800002, 2800003, 2800004, 2800005, 2800006, 2800007, 2800008, 2800009
