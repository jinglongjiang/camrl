[temporal]
T = 24
num_actions = 80
use_actions = true

[mamba]
d_model = 256
n_layers = 4
d_state = 64
d_conv = 4
expand = 2
dropout = 0.03
n_blocks = 3
temporal_backbone = mamba

[head]
use_goal_prior_train = false
use_goal_prior_eval = false

[bayesian_distributional]
K = 3
num_humans = 20
n_particles = 50
belief_seed = 4242
params_dir = runs/bayesian_distributional/gdbn_params_cv_residual_k3
belief_hidden_dim = 64
action_hidden_dim = 32
head_hidden_dim = 128
num_quantiles = 32
cvar_alpha = 0.20
risk_weight = 0.25
action_risk_horizon = 5
action_safe_distance = 0.20
action_risk_cvar_alpha = 0.80
action_pedestrian_aggregation = max

[bayesian_fullcrowd_risk]
risk_statistic = tail
collision_penalty_scale = 1.0
penalty_cap = 2.0

[eval_envs]
baseline_circle = circle:4.0:5
baseline_square = square:10.0:10
dense_circle = circle:4.0:10
dense_square = square:10.0:20
large_circle = circle:6.0:12
large_square = square:14.0:20

[eval_protocol]
episodes_per_env = 50
human_policies = orca,sfm
robot_visible = false
time_limit = 25
time_step = 0.25
success_radius = 0.25
discomfort_threshold = 0.2
safety_margin = 0.2
risk_lambda = 0.8
action_smoothing = 0.3
