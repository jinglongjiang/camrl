# ============================================================
# policy_bayesian_dvl.config - BayesianDVLPolicy.configure() section
# (guide.md 8.1/B4). See crowd_nav/bayesian_dvl/policy.py's
# BayesianDVLPolicy.configure() docstring for the exact contract.
# ============================================================

[bayesian_dvl]
registry_path = crowd_nav/configs/bayesian_dvl_registry_r4.json
artifact_path = runs/bayesian_dvl/production_artifact.json
; checkpoint_path must be set for any formal/validation run;
; smoke_mode = true is the ONLY way to run without one, and must never
; be set for a formal result (guide.md B6).
checkpoint_path =
smoke_mode = false
eval_phase = train
suite_seed = 0
