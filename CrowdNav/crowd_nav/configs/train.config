# ============================================================
# train.config - 训练配置
# ============================================================

[train]
algo = sarl
train_episodes = 10000
eval_every = 1000
eval_episodes = 50
save_every = 500

# 核心超参数
batch_size = 256
learning_rate = 1e-5
gamma = 0.99
updates_per_ep = 4

# IL阶段
il_epochs = 50
il_batch_size = 256
il_learning_rate = 1e-4

# Replay warmup
replay_warmup = 5000

[buffer]
capacity = 200000
seq_len = 24

[imitation_learning]
teacher_observation = policy
success_target = 5000
max_il_prefill = 50000
# SARL "降维打击"：IL用保守专家(0.25)，RL用宽松环境(0.10)
teacher_safety_space = 0.25
teacher_neighbor_dist = 6.0
teacher_max_neighbors = 15
teacher_time_horizon = 5.0
teacher_time_horizon_obst = 5.0

[sarl]
epsilon_start = 0.3
epsilon_end = 0.05
epsilon_decay_episodes = 1500
value_lr = 1e-5

[doubleq]
# Conservative online fine-tuning for the direct-action Mamba baseline.
learning_rate = 1e-5
backbone_learning_rate = 1e-6
freeze_backbone_episodes = 1000
epsilon_start = 0.3
epsilon_end = 0.05
epsilon_decay_episodes = 1500

# Preserve the ORCA behavior-cloning policy while learning TD values.
td_weight = 0.25
bc_weight_start = 1.0
bc_weight_end = 0.5
bc_weight_decay_episodes = 3000
bc_temperature = 1.0
q_target_min = -0.5
q_target_max = 1.0

# Evaluate early and stop before catastrophic forgetting can accumulate.
eval_every = 250
eval_episodes = 50
collapse_ratio = 0.60
collapse_patience = 2
early_stop_patience = 6
min_evals_before_stop = 3
