# Clean policy config for the accepted mainline:
# Mamba q_head proposes actions; K4 GDBN is the Bayesian safety governor.

[policy]
key = mamba_rl

[temporal]
T = 24

[mamba]
d_model = 256
n_layers = 4
d_state = 64
d_conv = 4
expand = 2
dropout = 0.03
n_blocks = 3

[head]
use_goal_prior_train = false
use_goal_prior_eval = false

[eval_envs]
baseline_circle = circle:4.0:5
baseline_square = square:10.0:10
dense_circle = circle:4.0:10
dense_square = square:10.0:20
large_circle = circle:6.0:12
large_square = square:14.0:20

[eval_protocol]
episodes_per_env = 100
human_policies = orca
robot_visible = false
time_limit = 25
time_step = 0.25
success_radius = 0.25
discomfort_threshold = 0.2
safety_margin = 0.0
risk_lambda = 0.0
action_smoothing = 0.0
beta_uncertainty = 0.0
# Clean selector: q_head top-k proposal, light progress/clearance utility, K4 risk veto.
q_only_rerank_topk = 8
q_only_progress_weight = 1.2
q_only_speed_weight = 0.05
q_only_clearance_margin = 0.05
q_only_clearance_penalty = 2.5
q_only_stop_penalty = 0.05
# Unified progress utility for out-of-distribution large-radius cases.
# This replaces the old test-only mamba_bias and finish patches.
utility_far_goal_radius = 2.0
utility_far_topk = 24
utility_progress_floor = 0.04
utility_far_progress_weight = 1.5
utility_far_speed_weight = 0.25
utility_far_min_clearance = 0.22

bayesian_policy_mode = safety_layer
bayesian_rerank_topk = 8
bayesian_progress_weight = 0.0
bayesian_speed_weight = 0.0
bayesian_clearance_margin = 0.10
bayesian_clearance_penalty = 4.0
bayesian_stop_penalty = 0.0
bayesian_q_veto_mode = true
bayesian_follow_q_only_shape = true
bayesian_rl_reranker_enable = false
bayesian_rl_reranker_topk = 8
bayesian_rl_reranker_scale = 1.0
bayesian_q_prior_belief_mode = zero
bayesian_risk_veto_threshold = 0.35
bayesian_override_min_clearance = 0.22
# Value-lookahead scoring weight used by the accepted champion runtime.
# Config overrides checkpoint meta when non-zero.
bayesian_value_lookahead_risk_weight = 1.2
# Extra-human kinematic veto: short-horizon constant-velocity projection for
# humans beyond nearest-5. Veto any action that would bring robot within
# extra_human_veto_clearance of any extra human within extra_human_veto_horizon steps.
extra_human_veto_clearance = 0.05
extra_human_veto_horizon = 3
extra_human_penalty_margin = 0.25
extra_human_penalty_weight = 4.0

[belief]
# 23-dim token layout per entity (13 base + 10 belief). Route-A: 8 humans → 11 entities.
enable = true
base_token_dim = 13
belief_dim = 10
token_dim = 23
num_entities = 11
human_start = 3
num_humans = 8
klda_clip = 5.0

[human_selection]
# Path Y-v1 champion selector. Keep this at threat when fine-tuning from
# rl_model_pathY_champion_82_8.pth; hybrid 3+5 was tested and regressed.
mode = threat
k_nearest = 3
k_threat = 5
horizon = 5
ttc_weight = 2.0
clearance_weight = 1.0
distance_weight = 0.15
closing_weight = 0.25
encoder_order = preserve
relation_frame = token

[gdbn]
K = 4
n_particles = 50
params_dir = gdbn_params_k4
demo_path = ../orca_demos_seq.npz
gng_epochs = 3
online_update_enable = false

[bayesian_core]
enable = true
rollout_horizon = 5
train_rollout_horizon = 5
safe_distance = 0.50
risk_weight = 0.0
uncertainty_weight = 0.0
klda_weight = 0.0
epistemic_weight = 0.0
reward_weight = 1.0
action_residual_weight = 0.0
action_prior_temperature = 1.0
value_bootstrap_weight = 0.0
cvar_alpha = 0.80
require_action_model = true
require_action_indices = true
