# ============================================================
# train_bayesian_dvl.config - BDVL training hyperparameters
# (guide.md 8.1/B4, section 11's frozen values). This file documents
# the same numbers as crowd_nav.bayesian_dvl.config.FROZEN_VALUES;
# Python code reads FROZEN_VALUES directly (not this file) so the two
# can never silently drift -- this file exists for guide.md's file
# layout and for human-readable reference, not as a second source of
# truth read at runtime.
# ============================================================

[training]
gamma = 0.99
replay_capacity = 200000
demo_sample_ratio = 0.20
batch_size = 256
learning_rate = 1e-4
rl_min_episodes = 3000
rl_max_episodes = 10000
epsilon_start = 0.30
epsilon_end = 0.05
updates_per_episode = 1
il_episodes = 5000

[iqn]
iqn_cosines = 64
iqn_train_quantiles = 16
iqn_quantiles_validation = 32
iqn_quantiles_formal = 64

[world_samples]
world_samples_train = 8
world_samples_validation = 16
world_samples_formal = 32

[cvar]
cvar_alpha = 0.20
