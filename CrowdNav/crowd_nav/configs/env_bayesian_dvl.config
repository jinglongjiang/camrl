# ============================================================
# env_bayesian_dvl.config - BDVL-specific frozen environment config
# (guide.md 8.1/B4). Copied from crowd_nav/configs/env.config with
# BDVL's own frozen overrides (guide.md section 11):
#   - time_limit 50 -> 35 (unifies the historical 25/35/50s split)
#   - progress_reward 0.0 -> 0.01 -> 0.05, time_penalty 0.0 -> -0.003
#     (matches the belief_mdp/gdbn/bayesian_brne lineage's convention,
#     NOT this base env.config's stale sparse-reward defaults; R3-5
#     fix 2026-08-07 raised progress_reward again to 0.05 so the
#     forward-vs-backward single-step reward gap is not swamped by
#     value-estimation noise -- see config.FROZEN_VALUES's comment for
#     the full derivation. This value MUST stay identical to
#     FROZEN_VALUES["progress_reward"]: crowd_sim.py reads it directly
#     for the REAL reward signal, while transition.py reads the Python
#     copy for hypothetical candidate scoring -- both must match or
#     BDVL's decision-time scoring silently diverges from what it was
#     actually trained on.
# The [policy] action grid section (n_speeds/n_headings/sampling/
# include_stop) is UNCHANGED and load-bearing: config.ActionGridSpec
# hard-asserts these exact values.
# ============================================================

[env]
time_limit = 35
time_step = 0.25
val_size = 100
test_size = 500
randomize_attributes = false

[reward]
success_reward = 1.0
collision_penalty = -0.5
timeout_penalty = -0.5
progress_reward = 0.05
time_penalty = -0.003
stand_penalty = 0.0
discomfort_dist = 0.2
discomfort_penalty_factor = 0.5

[sim]
train_val_sim = circle_crossing
test_sim = circle_crossing
square_width = 10
circle_radius = 4
human_num = 5

[humans]
visible = true
policy = orca
radius = 0.3
v_pref = 1.0
sensor = coordinates

[robot]
# Order 12: the robot is INVISIBLE to pedestrians. With visible=true the
# humans' own ORCA included the robot in their avoidance, so they actively
# yielded and the robot was solving a cooperative problem -- an ORCA robot
# scored 0.942 under that setting versus 0.51 in the literature protocol.
# The robot must now avoid unilaterally. Training and evaluation share this
# definition; the source no longer overrides it.
visible = false
policy = bayesian_dvl
radius = 0.3
v_pref = 1.0
sensor = coordinates
success_radius = 0.25

[orca]
neighbor_dist = 10.0
max_neighbors = 10
time_horizon = 5.0
time_horizon_obst = 5.0
safety_space = 0.10

[action_space]
kinematics = holonomic

[policy]
n_speeds = 5
n_headings = 16
v_min = 0.05
v_max = 1.0
sampling = exponential
include_stop = false
stop_eps = 0.05
