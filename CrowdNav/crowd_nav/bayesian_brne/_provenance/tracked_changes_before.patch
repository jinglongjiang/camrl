+def _latest_rl_checkpoint(outdir: str) -> Optional[str]:
+    candidates = []
+    for path in glob.glob(os.path.join(outdir, "rl_model_ep*.pth")):
+        match = re.search(r"rl_model_ep(\d+)\.pth$", os.path.basename(path))
