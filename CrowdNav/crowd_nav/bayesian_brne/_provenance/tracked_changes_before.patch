-            if st:
-                for k in keys:
-                    if k in st: agg[k] += float(st[k])
-                cnt += 1
-        if cnt > 0:
-            for k in keys: agg[k] /= cnt
-
-        # 合并轨迹
-        traj = []
-        for r in results:
-            traj.extend(r.get("traj", []))
