# ============================================================
# policy.config - 模型架构配置 (SSOT - Single Source of Truth)
# ============================================================
#
# 文件职责：神经网络结构参数（层数、维度、头部配置）
#
# 包含sections:
#   [temporal]      - 时序参数（T=序列长度、num_actions）
#   [mamba]         - Mamba架构参数（d_model、n_layers、d_state、d_conv）
#   [head]          - 输出头配置（goal_prior等）
#   [eval_envs]     - 评估环境配置（CAMRL论文对标）
#   [eval_protocol] - 评估协议（测试回合数、人类策略等）
#
# ⚠️  训练超参数（batch_size、learning_rate等）在 train.config
# ⚠️  环境物理参数（time_step、circle_radius等）在 env.config
# ============================================================

[temporal]
T = 24
num_actions = 80
use_actions = true

[mamba]
# ============================================================
# SSOT: Mamba架构参数的唯一定义（todo.md优化方案）
# 小号Mamba-2配置：平衡3060性能与SRN场景需求
# ============================================================
d_model = 256
n_layers = 4
d_state = 64
d_conv = 4
expand = 2
dropout = 0.03
n_blocks = 3
# Temporal backbone for controlled ablations: mamba or gru.
temporal_backbone = mamba

[head]
# 训练期关闭goal_prior
use_goal_prior_train = false
use_goal_prior_eval = false

# ============================================================
# 论文对标评估配置（CAMRL Diverse-4 Benchmark）
# 参考：todo.md测试步骤 - 6种环境（2形状 × 3密度）
# 注意：训练环境在env.config:[sim]，评估环境在此处[eval_envs]
# ============================================================

[eval_envs]
# 格式：环境名 = 形状:尺寸参数:行人数
# Baseline环境（密度0.1人/m²，论文标准训练环境）
baseline_circle = circle:4.0:5
baseline_square = square:10.0:10

# Dense环境（密度0.2人/m²，人数翻倍，测试拥挤场景）
dense_circle = circle:4.0:10
dense_square = square:10.0:20

# Large环境（面积扩大1.5倍，保持0.1人/m²密度，测试长距离规划）
large_circle = circle:6.0:12
large_square = square:14.0:20

[eval_protocol]
# 每种环境的测试回合数（论文标准：50次独立测试）
episodes_per_env = 50
# 行人策略切换（论文要求：ORCA和SFM两轮，测试鲁棒性）
human_policies = orca,sfm
# 机器人可见性（论文要求：invisible，确保主动避让而非"霸道"）
robot_visible = false
# 评估物理参数（与训练一致）
time_limit = 25
time_step = 0.25
success_radius = 0.25
# 不舒适距离阈值（论文Table I指标）
discomfort_threshold = 0.2
# === Test-time safety tweaks (no training impact) ===
# 用于评测阶段减少碰撞/抖动（可按需调大/调小）
safety_margin = 0.2
risk_lambda = 0.8
action_smoothing = 0.3
